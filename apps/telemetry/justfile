# Recipes for the telemetry collector Worker. Run from the repo root as
# `just telemetry::<recipe>`, or from this directory as `just <recipe>`.

[private]
default:
    @just --list

# Run the Worker locally with a simulated Analytics Engine binding
dev:
    pnpm run dev

# Deploy the Worker to Cloudflare
deploy:
    pnpm run deploy

# Regenerate src/v1/ping-schema.gen.ts from the Rust `Ping` type
generate-schema:
    cargo run --quiet --manifest-path ../../rust/Cargo.toml -p ccusage-telemetry --bin generate-telemetry-schema -- src/v1/ping-schema.gen.ts
    oxfmt --write src/v1/ping-schema.gen.ts

# Run the Worker's Node tests
test:
    TZ=UTC node --test src/v1/ping.test.ts src/rollup.test.ts src/stats.test.ts
