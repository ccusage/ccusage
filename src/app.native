<column background="background">
  <row height="68" padding="18" gap="12" cross="center" background="background" window-drag="true" label="Usage titlebar">
    <button size="sm" variant="outline" label="Back">&lt;</button>
    <column gap="2">
      <text size="heading" label="Usage"><span weight="bold">Usage</span></text>
      <text size="sm" foreground="text_muted">{dateRange}</text>
    </column>
    <spacer grow="1" />
    <button size="sm" variant="outline" on-press="range7" label="7 days">7 days</button>
    <button size="sm" variant="outline" on-press="range30" label="30 days">30 days</button>
    <button size="sm" variant="outline" on-press="range90" label="90 days">90 days</button>
    <button size="sm" variant="outline" on-press="refresh" label="Refresh">Refresh</button>
  </row>

  <scroll grow="1" label="Usage dashboard">
    <column padding="26" gap="24">
      <row gap="28" label="Cost overview">
        <column width="360" gap="18">
          <column gap="6">
            <text size="sm" foreground="text_muted">RAW TOKEN COST</text>
            <text size="heading"><span weight="bold">{rawTokenCost}</span></text>
            <text size="sm" foreground="text_muted">* if billed at full API rate</text>
          </column>

          <column gap="12" label="Providers">
            <text><span weight="bold">Providers</span></text>
            <for each="providers" as="p" key="name">
              <panel padding="14" background="surface" radius="lg" border-color="border" label="{p.name}">
                <column gap="8">
                  <row cross="center">
                    <text><span weight="bold">{p.name}</span></text>
                    <spacer grow="1" />
                    <text>{p.amount}</text>
                  </row>
                  <text size="sm" foreground="text_muted">{p.detail}</text>
                  <separator />
                </column>
              </panel>
            </for>
          </column>
        </column>

        <column grow="1" gap="12">
          <row cross="center">
            <text><span weight="bold">{modeLabel}</span></text>
            <spacer grow="1" />
            <button size="sm" variant="outline" on-press="cost" label="Cost">COST</button>
            <button size="sm" variant="outline" on-press="tokens" label="Tokens">TOKENS</button>
          </row>
          <panel height="330" padding="16" background="background" radius="lg" border-color="border" label="Daily usage chart">
            <column gap="10">
              <text size="sm" foreground="text_muted">Codex / Claude Code</text>
              <chart grow="1" y-min="0" y-max="1" label="Daily usage chart">
                <series kind="area" values="{dailySeries}" />
              </chart>
              <row>
                <text size="sm" foreground="text_muted">Jul 11</text>
                <spacer grow="1" />
                <text size="sm" foreground="text_muted">Aug 9</text>
              </row>
            </column>
          </panel>
        </column>
      </row>

      <panel padding="0" background="surface" radius="lg" border-color="border" label="Totals">
        <row gap="0">
          <for each="totals" as="t" key="label">
            <column grow="1" padding="16" gap="5">
              <text size="sm" foreground="text_muted">{t.label}</text>
              <text size="heading"><span weight="bold">{t.value}</span></text>
              <text size="sm" foreground="text_muted">{t.detail}</text>
            </column>
          </for>
        </row>
      </panel>

      <column gap="12" label="Breakdown">
        <row cross="center">
          <text><span weight="bold">Breakdown</span></text>
          <spacer grow="1" />
          <button size="sm" variant="outline" label="Model">MODEL</button>
          <button size="sm" variant="outline" label="Day">DAY</button>
        </row>

        <panel padding="14" background="background" radius="lg" border-color="border" label="Usage breakdown table">
          <column gap="0">
            <row height="34" cross="center">
              <text grow="1" size="sm" foreground="text_muted">Model</text>
              <text width="120" size="sm" foreground="text_muted" text-alignment="end">Cost</text>
              <text width="90" size="sm" foreground="text_muted" text-alignment="end">Share</text>
              <text width="110" size="sm" foreground="text_muted" text-alignment="end">Tokens</text>
            </row>
            <separator />
            <for each="breakdown" as="b" key="model">
              <row height="46" gap="12" cross="center" label="{b.model}">
                <column grow="1" gap="1">
                  <text>{b.model}</text>
                  <text size="sm" foreground="text_muted">{b.provider}</text>
                </column>
                <text width="120" text-alignment="end">{b.cost}</text>
                <text width="90" size="sm" foreground="text_muted" text-alignment="end">{b.share}</text>
                <text width="110" size="sm" foreground="text_muted" text-alignment="end">{b.tokens}</text>
              </row>
              <separator />
            </for>
          </column>
        </panel>
      </column>

      <text size="sm" foreground="text_muted">{refreshStatus}</text>
    </column>
  </scroll>
</column>
