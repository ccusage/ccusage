<column background="background">
  <row height="54" padding="16" gap="12" cross="center" background="surface" window-drag="true" label="ccusage titlebar">
    <text size="heading" label="ccusage"><span weight="bold">ccusage</span></text>
    <text size="sm" foreground="text_muted">Native usage dashboard</text>
    <spacer grow="1" />
    <button size="sm" variant="outline" on-press="refresh" label="Refresh usage">Refresh</button>
  </row>
  <separator />

  <row grow="1">
    <column width="210" padding="16" gap="8" background="surface" label="Navigation">
      <text size="sm" foreground="text_muted">WORKSPACE</text>
      <button size="sm" variant="outline" on-press="overview" label="Overview">Overview</button>
      <button size="sm" variant="outline" on-press="agents" label="Agents">Agents</button>
      <button size="sm" variant="outline" on-press="models" label="Models">Models</button>
      <button size="sm" variant="outline" on-press="sessions" label="Sessions">Sessions</button>
      <spacer grow="1" />
      <text size="sm" foreground="text_muted">Local-first · no cloud account</text>
    </column>

    <separator />

    <scroll grow="1" label="Dashboard content">
      <column padding="24" gap="18">
        <row cross="center" gap="12">
          <column gap="4">
            <text size="heading" label="{title}"><span weight="bold">{title}</span></text>
            <text size="sm" foreground="text_muted">{subtitle}</text>
          </column>
          <spacer grow="1" />
          <badge variant="secondary">{range}</badge>
        </row>

        <if test="{pageIsOverview}">
          <column gap="18">
            <row gap="12" label="Summary metrics">
              <panel grow="1" height="122" padding="16" background="surface" radius="lg" border-color="border" label="Total cost">
                <column gap="7">
                  <text size="sm" foreground="text_muted">TOTAL COST</text>
                  <text size="heading"><span weight="bold">{totalCost}</span></text>
                  <badge variant="secondary">{costDelta}</badge>
                </column>
              </panel>
              <panel grow="1" height="122" padding="16" background="surface" radius="lg" border-color="border" label="Total tokens">
                <column gap="7">
                  <text size="sm" foreground="text_muted">TOKENS</text>
                  <text size="heading"><span weight="bold">{totalTokens}</span></text>
                  <badge variant="secondary">{tokenDelta}</badge>
                </column>
              </panel>
              <panel grow="1" height="122" padding="16" background="surface" radius="lg" border-color="border" label="Active days">
                <column gap="7">
                  <text size="sm" foreground="text_muted">ACTIVE DAYS</text>
                  <text size="heading"><span weight="bold">{activeDays}</span></text>
                  <badge variant="secondary">{dayDelta}</badge>
                </column>
              </panel>
              <panel grow="1" height="122" padding="16" background="surface" radius="lg" border-color="border" label="Average daily cost">
                <column gap="7">
                  <text size="sm" foreground="text_muted">DAILY AVG</text>
                  <text size="heading"><span weight="bold">{avgDaily}</span></text>
                  <badge variant="secondary">{avgDelta}</badge>
                </column>
              </panel>
            </row>

            <row gap="12">
              <panel grow="1" height="210" padding="16" background="surface" radius="lg" border-color="border" label="Cost history">
                <column gap="12">
                  <text label="Spend over time"><span weight="bold">Spend over time</span></text>
                  <text size="sm" foreground="text_muted">Daily estimated API-equivalent cost</text>
                  <chart grow="1" y-min="0" y-max="1" label="Cost history chart">
                    <series kind="area" values="{costHistory}" />
                  </chart>
                </column>
              </panel>
              <panel grow="1" height="210" padding="16" background="surface" radius="lg" border-color="border" label="Token history">
                <column gap="12">
                  <text label="Token volume"><span weight="bold">Token volume</span></text>
                  <text size="sm" foreground="text_muted">Relative daily token usage</text>
                  <chart grow="1" y-min="0" y-max="1" label="Token history chart">
                    <series kind="bar" values="{tokenHistory}" />
                  </chart>
                </column>
              </panel>
            </row>

            <panel padding="16" background="surface" radius="lg" border-color="border" label="Recent usage">
              <column gap="10">
                <row cross="center">
                  <text label="Recent usage"><span weight="bold">Recent usage</span></text>
                  <spacer grow="1" />
                  <text size="sm" foreground="text_muted">Latest five days</text>
                </row>
                <separator />
                <for each="recentDays" as="r" key="date">
                  <row height="36" gap="12" cross="center" label="{r.day} {r.date}">
                    <text width="120">{r.day}</text>
                    <text width="90" size="sm" foreground="text_muted">{r.date}</text>
                    <spacer grow="1" />
                    <text width="100" size="sm" text-alignment="end">{r.tokens}</text>
                    <text width="90" size="sm" text-alignment="end">{r.cost}</text>
                    <badge variant="secondary">{r.change}</badge>
                  </row>
                </for>
              </column>
            </panel>

            <panel padding="16" background="surface" radius="lg" border-color="border" label="Top agents">
              <column gap="10">
                <text label="Top agents"><span weight="bold">Top agents</span></text>
                <separator />
                <for each="topAgents" as="a" key="name">
                  <row height="48" gap="12" cross="center" label="{a.name}">
                    <column width="260" gap="2">
                      <text>{a.name}</text>
                      <text size="sm" foreground="text_muted">{a.detail}</text>
                    </column>
                    <spacer grow="1" />
                    <text width="100" size="sm" text-alignment="end">{a.tokens}</text>
                    <text width="90" size="sm" text-alignment="end">{a.cost}</text>
                    <badge variant="secondary">{a.share}</badge>
                  </row>
                </for>
              </column>
            </panel>
          </column>
        </if>

        <if test="{pageIsAgents}">
          <panel padding="20" background="surface" radius="lg" border-color="border" label="Agents view">
            <column gap="12">
              <text size="heading"><span weight="bold">Agents</span></text>
              <text foreground="text_muted">Compare usage across Codex, Claude Code, OpenCode and Gemini CLI.</text>
              <separator />
              <for each="topAgents" as="a" key="name">
                <row height="54" cross="center" gap="12">
                  <column width="300" gap="2"><text>{a.name}</text><text size="sm" foreground="text_muted">{a.detail}</text></column>
                  <spacer grow="1" /><text>{a.tokens}</text><text width="100" text-alignment="end">{a.cost}</text><badge variant="secondary">{a.share}</badge>
                </row>
              </for>
            </column>
          </panel>
        </if>

        <if test="{pageIsModels}">
          <panel padding="20" background="surface" radius="lg" border-color="border" label="Models view">
            <column gap="10">
              <text size="heading"><span weight="bold">Models</span></text>
              <text foreground="text_muted">Model-level reporting is ready for live ccusage ingestion.</text>
              <separator />
              <text>GPT-5.6 Sol</text><text size="sm" foreground="text_muted">Codex · primary coding workload</text>
              <text>Claude Opus 4.1</text><text size="sm" foreground="text_muted">Claude Code · long-context sessions</text>
              <text>Gemini 2.5 Pro</text><text size="sm" foreground="text_muted">Gemini CLI · secondary usage</text>
            </column>
          </panel>
        </if>

        <if test="{pageIsSessions}">
          <panel padding="20" background="surface" radius="lg" border-color="border" label="Sessions view">
            <column gap="10">
              <text size="heading"><span weight="bold">Sessions</span></text>
              <text foreground="text_muted">Session drill-down with agent, model, tokens and cost.</text>
              <separator />
              <text>Recent sessions will appear here from local ccusage data.</text>
            </column>
          </panel>
        </if>
      </column>
    </scroll>
  </row>
</column>
