+++ b/process_stdin_test.go
@@ -0,0 +1,18 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCmdExecutionLargeStdin(t *testing.T) {
+	input := strings.Repeat("x", 1<<20)
+	command := cmdExecution{cmd: "cat", stdin: input}
+	output, err := command.run()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(output) != input {
+		t.Fatalf("received %d bytes, want %d", len(output), len(input))
+	}
+}
